{
  "name": "@kewen/dsh-model-controls",
  "version": "0.2.5",
  "private": true,
  "description": "DSH 模型控制器：切换模型、调节思考强度、收藏模型与调整供应商顺序。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "dsh-std": {
    "apiVersion": "dsh-std/v1",
    "domains": [
      "presentation"
    ],
    "platforms": [
      "web"
    ],
    "permissions": [
      "settings"
    ],
    "applies": "restart"
  },
  "scripts": {
    "bundle": "node run.mjs bundle",
    "typecheck": "node run.mjs typecheck",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "verify": "npm run bundle && npm test"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "MAGPIE_ASSET_LICENSE.md",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hu9956/DSH-model-controls.git"
  },
  "homepage": "https://github.com/Hu9956/DSH-model-controls#readme",
  "bugs": {
    "url": "https://github.com/Hu9956/DSH-model-controls/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model",
    "reasoning-effort"
  ]
}
