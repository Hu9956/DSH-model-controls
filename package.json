{
  "name": "@dsh-std/model-picker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "dsh-std": {
    "apiVersion": "dsh-std/v1",
    "domains": [
      "presentation"
    ],
    "platforms": [
      "web"
    ],
    "permissions": [],
    "applies": "restart"
  },
  "scripts": {
    "bundle": "node run.mjs bundle",
    "typecheck": "node run.mjs typecheck",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "verify": "npm run bundle && npm test"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "README.md"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
