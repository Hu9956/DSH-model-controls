{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "paths": {
      "@kewen/dsh-ui": [
        "../packages/dsh-ui/src/index.ts"
      ],
      "@kewen/dsh-ui/*": [
        "../packages/dsh-ui/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
